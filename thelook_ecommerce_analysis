/td>\n      <td>1798</td>\n      <td>154970.99</td>\n      <td>86.19</td>\n    </tr>\n    <tr>\n      <th>12</th>\n      <td>2026-04-01</td>\n      <td>3385</td>\n      <td>1852</td>\n      <td>161223.42</td>\n      <td>87.05</td>\n    </tr>\n    <tr>\n      <th>13</th>\n      <td>2026-05-01</td>\n      <td>3668</td>\n      <td>1991</td>\n      <td>171868.31</td>\n      <td>86.32</td>\n    </tr>\n    <tr>\n      <th>14</th>\n      <td>2026-06-01</td>\n      <td>3836</td>\n      <td>2128</td>\n      <td>183057.20</td>\n      <td>86.02</td>\n    </tr>\n    <tr>\n      <th>15</th>\n      <td>2026-07-01</td>\n      <td>4219</td>\n      <td>2275</td>\n      <td>189032.91</td>\n      <td>83.09</td>\n    </tr>\n    <tr>\n      <th>16</th>\n      <td>2026-08-01</td>\n      <td>4795</td>\n      <td>2614</td>\n      <td>215204.11</td>\n      <td>82.33</td>\n    </tr>\n    <tr>\n      <th>17</th>\n      <td>2026-09-01</td>\n      <td>5076</td>\n      <td>2764</td>\n      <td>236952.68</td>\n      <td>85.73</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":163},{"cell_type":"code","source":"print(\"Rows:\", len(monthly_kpi))\nprint(\"Unique months:\", monthly_kpi[\"order_month\"].nunique())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:10.644009Z","iopub.execute_input":"2026-11-09T15:25:10.644349Z","iopub.status.idle":"2026-11-09T15:25:10.649561Z","shell.execute_reply.started":"2026-11-09T15:25:10.644314Z","shell.execute_reply":"2026-11-09T15:25:10.648730Z"}},"outputs":[{"name":"stdout","text":"Rows: 18\nUnique months: 18\n","output_type":"stream"}],"execution_count":164},{"cell_type":"markdown","source":"### 4.1.2 Year-over-Year (YoY) Sales Analysis\n\n**Objective:** Compare monthly fulfilled-status sales performance between 2025 and 2026 to evaluate changes in order volume, monetary value, and average order value.\n\n**Methodology**\n\nMonthly KPIs are derived from the reusable `fact_orders` model and compared using a self-join that matches each month in 2026 with the corresponding month in 2025.\n\nThe analysis focuses on January–September to ensure comparable reporting periods.\n\n**Key Metrics**\n\n- **Order Volume YoY Growth (%):** Percentage change in fulfilled orders compared with the same month in the previous year.\n- **Fulfilled Value YoY Growth (%):** Percentage change in fulfilled-status order value.\n- **AOV YoY Growth (%):** Percentage change in average fulfilled order value.\n\nAll growth rates are calculated using the corresponding 2025 monthly values as the baseline.\n\n**Interpretation**\n\nThe monthly comparisons help distinguish whether changes in fulfilled-status monetary value are associated more closely with order volume or average order value.\n\nThe overall YTD comparison and consolidated findings are presented in the following sections.","metadata":{}},{"cell_type":"code","source":"monthly_yoy_sql = \"\"\"\n, monthly_metrics AS (\n    SELECT\n        order_month,\n\n        COUNTIF(\n            status IN ('Complete', 'Shipped')\n        ) AS fulfilled_orders,\n\n        SUM(fulfilled_order_value)\n            AS fulfilled_value,\n\n        SAFE_DIVIDE(\n            SUM(fulfilled_order_value),\n            COUNTIF(status IN ('Complete', 'Shipped'))\n        ) AS fulfilled_aov\n\n    FROM fact_orders\n    GROUP BY order_month\n)\n\nSELECT\n    curr.order_month,\n\n    -- Order volume comparison\n    prev.fulfilled_orders AS orders_2025,\n    curr.fulfilled_orders AS orders_2026,\n\n    ROUND(\n        100 * SAFE_DIVIDE(\n            curr.fulfilled_orders - prev.fulfilled_orders,\n            prev.fulfilled_orders\n        ), 2\n    ) AS orders_yoy_pct,\n\n    -- Monetary value comparison\n    ROUND(prev.fulfilled_value, 2) AS value_2025,\n    ROUND(curr.fulfilled_value, 2) AS value_2026,\n\n    ROUND(\n        100 * SAFE_DIVIDE(\n            curr.fulfilled_value - prev.fulfilled_value,\n            prev.fulfilled_value\n        ), 2\n    ) AS value_yoy_pct,\n\n    -- Average order value\n    ROUND(prev.fulfilled_aov, 2) AS aov_2025,\n    ROUND(curr.fulfilled_aov, 2) AS aov_2026,\n    \n    ROUND(\n        100 * SAFE_DIVIDE(\n            curr.fulfilled_aov - prev.fulfilled_aov,\n            prev.fulfilled_aov\n        ), 2\n    ) AS aov_yoy_pct\n\n\nFROM monthly_metrics AS curr\nLEFT JOIN monthly_metrics AS prev\n    ON prev.order_month =\n       DATE_SUB(curr.order_month, INTERVAL 1 YEAR)\n\nWHERE curr.order_month\n    BETWEEN DATE '2026-01-01' AND DATE '2026-09-01'\n\nORDER BY curr.order_month\n\"\"\"\n\nmonthly_yoy = run_fact_orders_query(monthly_yoy_sql)\n\nprint(\"Number of months:\", len(monthly_yoy))\n\nprint(\n    monthly_yoy[\n        [\n            \"orders_2025\",\n            \"orders_2026\",\n            \"value_2025\",\n            \"value_2026\"\n        ]\n    ].sum()\n)\n\nprint(\n    monthly_yoy[\n        [\n            \"orders_yoy_pct\",\n            \"value_yoy_pct\",\n            \"aov_yoy_pct\"\n        ]\n    ].isna().sum()\n)\n\nmonthly_yoy\n\n\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:10.650710Z","iopub.execute_input":"2026-11-09T15:25:10.651007Z","iopub.status.idle":"2026-11-09T15:25:11.697916Z","shell.execute_reply.started":"2026-11-09T15:25:10.650981Z","shell.execute_reply":"2026-11-09T15:25:11.697291Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/google/cloud/bigquery/table.py:2086: UserWarning: BigQuery Storage module not found, fetch data with the REST endpoint instead.\n  warnings.warn(\n","output_type":"stream"},{"name":"stdout","text":"Number of months: 9\norders_2025       10729.0\norders_2026       18621.0\nvalue_2025      918584.67\nvalue_2026     1593096.13\ndtype: Float64\norders_yoy_pct    0\nvalue_yoy_pct     0\naov_yoy_pct       0\ndtype: int64\n","output_type":"stream"},{"execution_count":165,"output_type":"execute_result","data":{"text/plain":"  order_month  orders_2025  orders_2026  orders_yoy