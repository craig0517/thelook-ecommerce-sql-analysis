item_value IS NULL)\n        AS missing_recorded_value,\n\n    COUNTIF(\n        recorded_item_value IS NOT NULL\n        AND (\n            fulfilled_order_value IS NULL\n            OR cancelled_returned_value IS NULL\n            OR processing_order_value IS NULL\n            OR ABS(\n                recorded_item_value\n                - (\n                    fulfilled_order_value\n                    + cancelled_returned_value\n                    + processing_order_value\n                )\n            ) > 0.01\n        )\n    ) AS value_mismatches\n\nFROM fact_orders\n\"\"\"\n\nnumerical_reconciliation = run_fact_orders_query(\n    numerical_reconciliation_sql\n)\n\nnumerical_reconciliation\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:08.264613Z","iopub.execute_input":"2026-11-09T15:25:08.264879Z","iopub.status.idle":"2026-11-09T15:25:09.635258Z","shell.execute_reply.started":"2026-11-09T15:25:08.264847Z","shell.execute_reply":"2026-11-09T15:25:09.634510Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/google/cloud/bigquery/table.py:2086: UserWarning: BigQuery Storage module not found, fetch data with the REST endpoint instead.\n  warnings.warn(\n","output_type":"stream"},{"execution_count":162,"output_type":"execute_result","data":{"text/plain":"   total_orders  total_recorded_value  total_fulfilled_value  \\\n0        112979             9812458.8             5380525.49   \n\n   total_cancelled_returned_value  total_processing_value  \\\n0                      2471741.51               1960191.8   \n\n   reconciliation_difference  missing_recorded_value  value_mismatches  \n0                        0.0                       0                 0  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }