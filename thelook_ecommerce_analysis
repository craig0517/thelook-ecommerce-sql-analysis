 average order value.\n\n*Note: The dataset is synthetic, and order status is observed at query time rather than reconstructed as of each historical month.*","metadata":{}},{"cell_type":"code","source":"monthly_kpi_sql = \"\"\"\nSELECT\n    order_month,\n\n    COUNT(*) AS total_orders,\n\n    COUNTIF(\n        status IN ('Complete', 'Shipped')\n    ) AS fulfilled_orders,\n\n    ROUND(\n        SUM(fulfilled_order_value), 2\n    ) AS fulfilled_order_value,\n\n    ROUND(\n        SAFE_DIVIDE(\n            SUM(fulfilled_order_value),\n            COUNTIF(status IN ('Complete', 'Shipped'))\n        ), 2\n    ) AS avg_fulfilled_order_value\n\nFROM fact_orders\nWHERE\n    order_month BETWEEN DATE '2025-01-01'\n                    AND DATE '2025-09-01'\n    OR\n    order_month BETWEEN DATE '2026-01-01'\n                    AND DATE '2026-09-01'\nGROUP BY order_month\nORDER BY order_month\n\"\"\"\n\nmonthly_kpi = run_fact_orders_query(monthly_kpi_sql)\nmonthly_kpi\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:09.636232Z","iopub.execute_input":"2026-11-09T15:25:09.636558Z","iopub.status.idle":"2026-11-09T15:25:10.643016Z","shell.execute_reply.started":"2026-11-09T15:25:09.636524Z","shell.execute_reply":"2026-11-09T15:25:10.642324Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/google/cloud/bigquery/table.py:2086: UserWarning: BigQuery Storage module not found, fetch data with the REST endpoint instead.\n  warnings.warn(\n","output_type":"stream"},{"execution_count":163,"output_type":"execute_result","data":{"text/plain":"   order_month  total_orders  fulfilled_orders  fulfilled_order_value  \\\n0   2025-01-01          1931              1073               96967.43   \n1   2025-02-01          1838              1045               89458.41   \n2   2025-03-01          2088              1108               90673.98   \n3   2025-04-01          2021              1130               97467.30   \n4   2025-05-01          