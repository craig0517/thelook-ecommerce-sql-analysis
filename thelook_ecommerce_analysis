E status IN ('Complete', 'Shipped')\n  AND user_id IS NOT NULL\n\"\"\")\n\ncustomer_source_check\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:22.150029Z","iopub.execute_input":"2026-11-09T15:25:22.150278Z","iopub.status.idle":"2026-11-09T15:25:23.116905Z","shell.execute_reply.started":"2026-11-09T15:25:22.150226Z","shell.execute_reply":"2026-11-09T15:25:23.116102Z"}},"outputs":[{"name":"stdout","text":"Total customer rows: 48357\nUnique customers: 48357\nTotal fulfilled orders: 62221\nTotal fulfilled value: 5380525.49\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/google/cloud/bigquery/table.py:2086: UserWarning: BigQuery Storage module not found, fetch data with the REST endpoint instead.\n  warnings.warn(\n","output_type":"stream"},{"execution_count":178,"output_type":"execute_result","data":{"text/plain":"   fulfilled_orders  fulfilled_value\n0             62221       5380525.49","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>fulfilled_orders</th>\n      <th>fulfilled_value</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>62221</td>\n      <td>5380525.49</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":178},{"cell_type":"markdown","source":"### 4.3.2 One-Time vs. Repeat Customer Segmentation\n\n**Objective:** Compare purchasing frequency and monetary contribution between one-time and repeat customers.\n\nCustomers are classified based on their number of fulfilled-status orders:\n\n- **One-Time Customers:** Customers with exactly one fulfilled order.\n- **Repeat Customers:** Customers with two or more fulfilled orders.\n\nThe analysis measures customer counts, fulfilled order volume, and fulfilled-status item value for each segment.\n\nOnly customers with at least one fulfilled-status order are included.","metadata":{}},{"cell_type":"code","source":"\ncustomer_segment_sql = \"\"\"\n, customer_metrics AS (\n    SELECT\n        user_id,\n        COUNT(*) AS fulfilled_order_count,\n        SUM(fulfilled_order_value) AS total_fulfilled_value\n    FROM fact_orders\n    WHERE status IN ('Complete', 'Shipped')\n      AND user_id IS NOT NULL\n    GROUP BY user_id\n),\n\nsegmented_customers AS (\n    SELECT\n        *,\n        CASE\n            WHEN fulfilled_order_count = 1 THEN 'one-time'\n            ELSE 'repeat'\n        END AS customer_segment\n    FROM customer_metrics\n    \n), segment_summary AS (\n    SELECT\n        customer_segment,\n        COUNT(*) AS customer_count,\n        SUM(fulfilled_order_count) AS fulfilled_order_count,\n        SUM(total_fulfilled_value) AS total_fulfilled_value,\n        ROUND(SAFE_DIVIDE(SUM(total_fulfilled_value),SUM(fulfilled_order_count)),2) AS avg_order_value, \n        ROUND(SAFE_DIVIDE(SUM(total_fulfilled_value),COUNT(*)), 2) AS avg_value_per_customer\n\n    FROM segmented_customers\n    GROUP BY customer_segment\n)\n\nSELECT\n    *,\n    ROUND(\n        100 * SAFE_DIVIDE(\n            customer_count,\n            SUM(customer_count) OVER()\n        ), 2\n    ) AS customer_share_pct,\n\n    ROUND(\n        100 * SAFE_DIVIDE(\n            total_fulfilled_value,\n            SUM(total_fulfilled_value) OVER()   \n        ), 2\n    ) AS value_contribution_pct,\n\n    \n\nFROM segment_summary\n\"\"\"\n\ncustomer_segments = run_fact_orders_query(customer_segment_sql)\n\n\ndisplay(\n    customer_segments.style.format({\n        \"customer_count\": \"{:,.0f}\",\n        \"fulfilled_order_count\": \"{:,.0f}\",\n        \"total_fulfilled_value\": \"${:,.2f}\",\n        \"customer_share_pct\": \"{:.2f}%\",\n        \"value_contribution_pct\": \"{:.2f}%\",\n        \"avg_order_value\": \"${:,.2f}\",\n        \"avg_value_per_customer\": \"${:,.2f}\"\n    })\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:34:56.705580Z","iopub.execute_input":"2026-11-09T15:34:56.705924Z","iopub.status.idle":"2026-11-09T15:34:58.191374Z","shell.execute_reply.started":"2026-11-09T15:34:56.705896Z","shell.execute_reply":"2026-11-09T15:34:58.190613Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/google/cloud/bigquery/table.py:2086: UserWarning: BigQuery Storage module not found, fetch data with the REST endpoint instead.\n  warnings.warn(\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<pandas.io.formats.style.Styler at 0x7915a5a74860>","text/html":"<style type=\"text/css\">\n</style>\n<table id=\"T_dff33\">\n  <thead>\n    <tr>\n      <th class=\"blank level0\" >&nbsp;</th>\n      <th id=\"T_dff33_level0_col0\" class=\"col_heading level0 col0\" >customer_segment</th>\n      <th id=\"T_dff33_level0_col1\" class=\"col_heading level0 col1\" >customer_count</th>\n      <th id=\"T_dff33_level0_col2\" class=\"col_heading level0 col2\" >fulfilled_order_count</th>\n      <th id=\"T_dff33_level0_col3\" class=\"col_heading level0 col3\" >total_fulfilled_value</th>\n      <th id=\"T_dff33_level0_col4\" class=\"col_heading level0 col4\" >avg_order_value</th>\n      <th id=\"T_dff33_level0_col5\" class=\"col_heading level0 col5\" >avg_value_per_customer</th>\n      <th id=\"T_dff33_level0_col6\" class=\"col_heading level0 col6\" >customer_share_pct</th>\n      <th id=\"T_dff33_level0_col7\" class=\"col_heading level0 col7\" >value_contribution_pct</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th id=\"T_dff33_level0_row0\" class=\"row_heading level0 row0\" >0</th>\n      <td id=\"T_dff33_row0_col0\" class=\"data row0 col0\" >one-time</td>\n      <td id=\"T_dff33_row0_col1\" class=\"data row0 col1\" >37,244</td>\n      <td id=\"T_dff33_row0_col2\" class=\"data row0 col2\" >37,244</td>\n      <td id=\"T_dff33_row0_col3\" class=\"data row0 col3\" >$3,207,612.81</td>\n      <td id=\"T_dff33_row0_col4\" class=\"data row0 col4\" >$86.12</td>\n      <td id=\"T_dff33_row0_col5\" class=\"data row0 col5\" >$86.12</td>\n      <td id=\"T_dff33_row0_col6\" class=\"data row0 col6\" >77.02%</td>\n      <td id=\"T_dff33_row0_col7\" class=\"data row0 col7\" >59.62%</td>\n    </tr>\n    <tr>\n      <th id=\"T_dff33_level0_row1\" class=\"row_heading level0 row1\" >1</th>\n      <td id=\"T_dff33_row1_col0\" class=\"data row1 col0\" >repeat</td>\n      <td id=\"T_dff33_row1_col1\" class=\"data row1 col1\" >11,113</td>\n      <td id=\"T_dff33_row1_col2\" class=\"data row1 col2\" >24,977</td>\n      <td id=\"T_dff33_row1_col3\" class=\"data row1 col3\" >$2,172,912.67</td>\n      <td id=\"T_dff33_row1_col4\" class=\"data row1 col4\" >$87.00</td>\n      <td id=\"T_dff33_row1_col5\" class=\"data row1 col5\" >$195.53</td>\n      <td id=\"T_dff33_row1_col6\" class=\"data row1 col6\" >22.98%</td>\n      <td id=\"T_dff33_row1_col7\" class=\"data row1 col7\" >40.38%</td>\n    </tr>\n  </tbody>\n</table>\n"},"metadata":{}}],"execution_count":186},{"cell_type":"markdown","source":"#### Key Findings — Customer Purchasing Behavior\n\n**1. Repeat customers contribute a disproportionate share of fulfilled-status monetary value.**\n\nRepeat customers represent **22.98%** of purchasing customers but account for **40.38%** of total fulfilled-status item value.\n\n**2. Purchasing frequency is an important driver of customer-level monetary contribution.**\n\nThe higher monetary contribution per repeat customer is primarily associated with a greater number of fulfilled orders per customer, rather than a substantial difference in average order value.\n\n\n\n**Limitations**\n\nCustomer segments are based on observed fulfilled-status orders within the reporting scope. The results do not establish long-term customer loyalty, causal relationships, or actual customer lifetime value. TheLook is a synthetic dataset.","metadata":{}},{"cell_type":"markdown","source":"## 4.4 Customer Cohort & Retention Analysis\n\n### 4.4.1 Customer Cohort Construction\n\n**Objective:** Analyze monthly purchasing activity among customers grouped by their first observed fulfilled-order month.\n\n**Cohort Definition:** Customers are assigned to a cohort based on the month of their earliest fulfilled-status order.\n\n**Activity Definition:** A customer is considered active in a month if they have at least one fulfilled-status order during that month.\n\n**Analysis Scope:** Customer cohorts from January to December 2025 are tracked through September 2026.\n\n**Methodology:** Cohort assignment uses the full available order history up to the reporting cutoff. Monthly customer activity is deduplicated to ensure that multiple orders from the same customer within a month count as one active customer.\n\n*Note: The analysis measures observed repeat purchasing activity, not long-term loyalty. TheLook is a synthetic dataset, and order statuses reflect the dataset at query time.*","metadata":{}},{"cell_type":"code","source":"cohort_retention_sql = \"\"\"\n, customer_first_fulfilled AS (\n    SELECT\n        user_id,\n\n        -- TODO 1: Find earliest order_month\n        MIN(order_month) AS cohort_month\n\n    FROM fact_orders\n    WHERE status IN ('Complete', 'Shipped')\n      AND user_id IS NOT NULL\n    GROUP BY user_id\n),\n\nmonthly_customer_activity AS (\n    SELECT DISTINCT\n        -- TODO 2: One unique row per user_id and activity_month\n        user_id,\n        order_month AS activity_month\n\n    FROM fact_orders\n    WHERE status IN ('Complete', 'Shipped')\n      AND user_id IS NOT NULL\n      \n),\n\ncohort_activity AS (\n    SELECT\n        c.user_id,\n        c.cohort_month,\n        a.activity_month,\n    \n        DATE_DIFF(\n            a.activity_month,\n            c.cohort_month,\n            MONTH\n            ) as month_index\n    \n    FROM customer_first_fulfilled AS c\n    \n    INNER JOIN monthly_customer_activity AS a\n        ON c.user_id = a.user_id\n    \n    WHERE c.cohort_month BETWEEN DATE '2025-01-01'\n                             AND DATE '2025-12-01'\n    \n)\n\n, cohort_counts AS (\n    SELECT\n        cohort_month,\n        month_index,\n        COUNT(DISTINCT user_id) AS active_customers\n\n    FROM cohort_activity\n\n    GROUP BY cohort_month, month_index\n)\n\n, cohort_with_size AS (\n    SELECT\n        cohort_month,\n        month_index,\n        active_customers,\n\n        MAX(\n            CASE\n                WHEN month_index = 0\n                THEN active_customers\n            END\n        ) OVER (\n            PARTITION BY cohort_month\n        ) AS cohort_size\n\n    FROM cohort_counts\n)\n\nSELECT\n    cohort_month,\n    month_index,\n    active_customers,\n    cohort_size,\n\n    -- TODO: Calculate retention rate (%)\n    -- Use active_customers / cohort_size\n    -- Alias: retention_rate_pct\n\n    ROUND(SAFE_DIVIDE(active_customers,cohort_size) * 100,2) AS retention_rate_pct\n        \nFROM cohort_with_size\n\nORDER BY cohort_month, month_index\n\n\"\"\"\n\ncohort_retention = run_fact_orders_query(cohort_retention_sql)\n\ncohort_retention.head(10)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:24.587490Z","iopub.execute_input":"2026-11-09T15:25:24.587742Z","iopub.status.idle":"2026-11-09T15:25:25.796288Z","shell.execute_reply.started":"2026-11-09T15:25:24.587719Z","shell.execute_reply":"2026-11-09T15:25:25.795523Z"}},"outputs":[{"execution_count":180,"output_type":"execute_result","data":{"text/plain":"  cohort_month  month_index  active_customers  cohort_size  retention_rate_pct\n0   2025-01-01            0               780          780              100.00\n1   2025-01-01            1                 8          780                1.03\n2   2025-01-01            2                12          