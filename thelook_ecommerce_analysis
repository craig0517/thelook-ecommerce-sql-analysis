y>\n    <tr>\n      <th>0</th>\n      <td>2026-01-01</td>\n      <td>1073</td>\n      <td>1624</td>\n      <td>51.35</td>\n      <td>96967.43</td>\n      <td>139981.93</td>\n      <td>44.36</td>\n      <td>90.37</td>\n      <td>86.20</td>\n      <td>-4.62</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>2026-02-01</td>\n      <td>1045</td>\n      <td>1575</td>\n      <td>50.72</td>\n      <td>89458.41</td>\n      <td>140804.58</td>\n      <td>57.40</td>\n      <td>85.61</td>\n      <td>89.40</td>\n      <td>4.43</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>2026-03-01</td>\n      <td>1108</td>\n      <td>1798</td>\n      <td>62.27</td>\n      <td>90673.98</td>\n      <td>154970.99</td>\n      <td>70.91</td>\n      <td>81.84</td>\n      <td>86.19</td>\n      <td>5.32</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>2026-04-01</td>\n      <td>1130</td>\n      <td>1852</td>\n      <td>63.89</td>\n      <td>97467.30</td>\n      <td>161223.42</td>\n      <td>65.41</td>\n      <td>86.25</td>\n      <td>87.05</td>\n      <td>0.93</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>2026-05-01</td>\n      <td>1174</td>\n      <td>1991</td>\n      <td>69.59</td>\n      <td>102256.60</td>\n      <td>171868.31</td>\n      <td>68.08</td>\n      <td>87.10</td>\n      <td>86.32</td>\n      <td>-0.89</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>2026-06-01</td>\n      <td>1179</td>\n      <td>2128</td>\n      <td>80.49</td>\n      <td>100125.72</td>\n      <td>183057.20</td>\n      <td>82.83</td>\n      <td>84.92</td>\n      <td>86.02</td>\n      <td>1.29</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>2026-07-01</td>\n      <td>1287</td>\n      <td>2275</td>\n      <td>76.77</td>\n      <td>105803.73</td>\n      <td>189032.91</td>\n      <td>78.66</td>\n      <td>82.21</td>\n      <td>83.09</td>\n      <td>1.07</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>2026-08-01</td>\n      <td>1336</td>\n      <td>2614</td>\n      <td>95.66</td>\n      <td>116964.53</td>\n      <td>215204.11</td>\n      <td>83.99</td>\n      <td>87.55</td>\n      <td>82.33</td>\n      <td>-5.96</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>2026-09-01</td>\n      <td>1397</td>\n      <td>2764</td>\n      <td>97.85</td>\n      <td>118866.97</td>\n      <td>236952.68</td>\n      <td>99.34</td>\n      <td>85.09</td>\n      <td>85.73</td>\n      <td>0.75</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":165},{"cell_type":"markdown","source":"### 4.1.3 Year-to-Date (YTD) Performance Comparison\n\n**Objective:** Evaluate overall changes in fulfilled-status sales performance by comparing January–September 2025 with January–September 2026.\n\n**Methodology**\n\nThe analysis aggregates order-level data from the reusable `fact_orders` model into annual summaries covering the same nine calendar months.\n\nThree key metrics are compared:\n\n- **Fulfilled Orders:** Total number of orders classified as Complete or Shipped.\n- **Fulfilled-Status Order Value:** Total recorded item value associated with fulfilled orders.\n- **Average Fulfilled Order Value (AOV):** Total fulfilled-status order value divided by total fulfilled orders.\n\nYTD AOV is calculated using the aggregate monetary value and order count rather than the unweighted average of monthly AOVs.\n\n**Validation — Monthly-to-YTD Reconciliation**\n\nTo verify consistency, the YTD fulfilled order counts and monetary totals are compared against the sums of the corresponding monthly YoY results.\n\nAutomated assertions are used to identify discrepancies between the two aggregation methods, allowing for minor monetary rounding differences.\n\n**Interpretation**\n\nThe YTD comparison summarizes the overall relationship between changes in order volume, fulfilled-status monetary value, and average order value.\n\nConsolidated analytical findings are presented in Section 4.1.4.\n\n*Limitation: TheLook is a synthetic dataset, and historical periods are classified using order statuses observed at query time.*","metadata":{}},{"cell_type":"code","source":"ytd_sql = \"\"\"\n, ytd_summary AS (\n    SELECT\n        EXTRACT(YEAR FROM order_date) AS year,\n        COUNTIF(status IN ('Complete','Shipped')) as fulfilled_orders,\n        SUM(fulfilled_order_value) AS fulfilled_value,\n        SAFE_DIVIDE(SUM(fulfilled_order_value), COUNTIF(status IN ('Complete','Shipped'))) AS fulfilled_aov\n\n    FROM fact_orders\n    WHERE (\n        order_date BETWEEN DATE '2025-01-01'\n                       AND DATE '2025-09-30'\n    )\n    OR (\n        order_date BETWEEN DATE '2026-01-01'\n                       AND DATE '2026-09-30'\n    )\n    GROUP BY year\n)\n\nSELECT\n\n    prev.fulfilled_orders AS orders_2025,\n    curr.fulfilled_orders AS orders_2026,\n\n    ROUND(\n        100 * SAFE_DIVIDE(\n            curr.fulfilled_orders - prev.fulfilled_orders,\n            prev.fulfilled_orders\n        ), 2\n    ) AS orders_yoy_pct,\n\n\n    -- Monetary value comparison\n    ROUND(prev.fulfilled_value, 2) AS value_2025,\n    ROUND(curr.fulfilled_value, 2) AS value_2026,\n\n    ROUND(\n        100 * SAFE_DIVIDE(\n            curr.fulfilled_value - prev.fulfilled_value,\n            prev.fulfilled_value\n        ), 2\n    ) AS value_yoy_pct,\n\n    -- Average order value\n    \n    ROUND(prev.fulfilled_aov, 2) AS aov_2025,\n    ROUND(curr.fulfilled_aov, 2) AS aov_2026,\n    ROUND(\n        100 * SAFE_DIVIDE(\n            curr.fulfilled_aov - prev.fulfilled_aov,\n            prev.fulfilled_aov\n        ), 2\n    ) AS aov_yoy_pct\n\n\nFROM ytd_summary AS curr\nJOIN ytd_summary AS prev\n    ON curr.year = 2026\n   AND prev.year = 2025\n\"\"\"\n\nytd_results = run_fact_orders_query(ytd_sql)\n\n\n\n# Reconcile monthly YoY totals against YTD results\n\nmetrics = [\n    \"orders_2025\",\n    \"orders_2026\",\n    \"value_2025\",\n    \"value_2026\"\n]\n\nmonthly_totals = monthly_yoy[metrics].sum()\nytd_totals = ytd_results.iloc[0]\n\nfor metric in metrics:\n    difference = (\n        float(monthly_totals[metric])\n        - float(ytd_totals[metric])\n    )\n\n    # Allow small monetary rounding differences\n    tolerance = 0 if metric.startswith(\"orders\") else 0.02\n\n    print(f\"{metric}: difference = {difference:.2f}\")\n\n    assert abs(difference) <= tolerance, (\n        f\"Reconciliation failed for {metric}\"\n    )\n\nprint(\"Monthly-to-YTD reconciliation passed.\")\n\n\n\nytd_results","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:11.698907Z","iopub.execute_input":"2026-11-09T15:25:11.699198Z","iopub.status.idle":"2026-11-09T15:25:12.741527Z","shell.execute_reply.started":"2026-11-09T15:25:11.699174Z","shell.execute_reply":"2026-11-09T15:25:12.740843Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/google/cloud/bigquery/table.py:2086: UserWarning: BigQuery Storage module not found, fetch data with the REST endpoint instead.\n  warnings.warn(\n","output_type":"stream"},{"name":"stdout","text":"orders_2025: difference = 0.00\norders_2026: difference = 0.00\nvalue_2025: difference = -0.00\nvalue_2026: difference = 0.00\nMonthly-to-YTD reconciliation passed.\n","output_type":"stream"},{"execution_count":166,"output_type":"execute_result","data":{"text/plain":"   orders_2025  orders_2026  orders_yoy_pct  value_2025  value_2026  \\\n0        10729        18621           73.56   918584.67  1593096.13   \n\n   value_yoy_pct  aov_2025  aov_2026  aov_yoy_pct  \n0          73.43     85.62     85.55        -0.07  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>orders_2025</th>\n      <th>orders_2026</th>\n  