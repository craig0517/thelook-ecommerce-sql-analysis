.742863Z","iopub.status.idle":"2026-11-09T15:25:13.162419Z","shell.execute_reply.started":"2026-11-09T15:25:12.742827Z","shell.execute_reply":"2026-11-09T15:25:13.161638Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 900x450 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 900x450 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":167},{"cell_type":"code","source":"# Render findings from the same YTD execution as the SQL tables above\nfrom IPython.display import Markdown, display\n\nk = ytd_results.iloc[0]\norder_growth = float(k['orders_yoy_pct'])\nvalue_growth = float(k['value_yoy_pct'])\naov_growth = float(k['aov_yoy_pct'])\n\nvolume_read = (\n    'Order-volume growth accounts for most of the increase in total value in this numerical comparison.'\n    if value_growth > 0 and order_growth > 0 and abs(order_growth) > abs(aov_growth)\n    else 'Order-volume and AOV changes should both be examined when interpreting total value.'\n)\n\ndisplay(Markdown(f\"\"\"\n#### Key Findings — Sales Performance\n\n1. **Fulfilled-status value:** January–September 2026 totaled **${float(k['value_2026']):,.2f}**, versus **${float(k['value_2025']):,.2f}** in 2025 (**{value_growth:+.2f}%**).\n2. **Order volume and AOV:** Fulfilled orders changed from **{int(k['orders_2025']):,}** to **{int(k['orders_2026']):,}** (**{order_growth:+.2f}%**); weighted AOV changed from **${float(k['aov_2025']):,.2f}** to **${float(k['aov_2026']):,.2f}** (**{aov_growth:+.2f}%**). {volume_read}\n3. **Internal consistency:** Monthly totals are checked against the YTD aggregate using reconciliation assertions in Section 4.1.3.\n\n**Limitation:** These results describe a synthetic dataset using order statuses observed at query time. They do not establish causal growth drivers or recognized accounting revenue.\n\"\"\"))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:13.163600Z","iopub.execute_input":"2026-11-09T15:25:13.164330Z","iopub.status.idle":"2026-11-09T15:25:13.172180Z","shell.execute_reply.started":"2026-11-09T15:25:13.164301Z","shell.execute_reply":"2026-11-09T15:25:13.171554Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<IPython.core.display.Markdown object>","text/markdown":"\n#### Key Findings — Sales Performance\n\n1. **Fulfilled-status value:** January–September 2026 totaled **$1,593,096.13**, versus **$918,584.67** in 2025 (**+73.43%**).\n2. **Order volume and AOV:** Fulfilled orders changed from **10,729** to **18,621** (**+73.56%**); weighted AOV changed from **$85.62** to **$85.55** (**-0.07%**). Order-volume growth accounts for most of the increase in total value in this numerical comparison.\n3. **Internal consistency:** Monthly totals are checked against the YTD aggregate using reconciliation assertions in Section 4.1.3.\n\n**Limitation:** These results describe a synthetic dataset using order statuses observed at query time. They do not establish causal growth drivers or recognized accounting revenue.\n"},"metadata":{}}],"execution_count":168},{"cell_type":"markdown","source":"## 4.2 Product & Category Performance Analysis","metadata":{}},{"cell_type":"markdown","source":"### 4.2.1 Category Sales Performance\n\n**Objective:** Identify which product categories contribute most to fulfilled-status item value and sales volume, and assess whether category performance is associated with item volume or average selling price.\n\nThe analysis combines `order_items`, `orders`, and `products` at the order-item level.\n\nTo maintain consistency with the sales-performance analysis, only orders classified as `Complete` or `Shipped` are included.\n\n**KPIs:**\n- Fulfilled item count\n- Number of orders containing each category\n- Fulfilled-status item value\n- Average item selling price\n- Category contribution to total fulfilled-status item value","metadata":{}},{"cell_type":"code","source":"category_sql = \"\"\"\nWITH item_scope AS (\n    SELECT\n        oi.id as item_id,\n        oi.order_id,\n        oi.sale_price,\n        COALESCE(p.category, 'Unknown') AS category\n    FROM `bigquery-public-data.thelook_ecommerce.order_items` oi\n\n    INNER JOIN `bigquery-public-data.thelook_ecommerce.orders` o\n        ON oi.order_id = o.order_id\n\n    LEFT JOIN `bigquery-public-data.thelook_ecommerce.products` p\n        on oi.product_id = p.id\n\n    WHERE DATE(o.created_at) <= DATE '2026-09-30'\n        AND o.status IN ('Complete', 'Shipped')\n),\n\ncategory_metrics AS (\n    SELECT \n        category,\n        COUNT(*) AS fulfilled_item_count,\n        COUNT(DISTINCT order_id) AS orders_containing_category,\n        SUM(sale_price) AS fulfilled_item_value,\n        ROUND(AVG(sale_price), 2) AS avg_item_sale_price\n    FROM item_scope\n    GROUP BY category\n)\n\nSELECT\n    *,\n    ROUND(\n        100 * SAFE_DIVIDE(\n            fulfilled_item_value, \n            \n            SUM(fulfilled_item_value) OVER () \n        ), 2\n    ) AS value_share_pct\nFROM category_metrics\nORDER BY fulfilled_item_value DESC\n\"\"\"\ncategory_results = client.query(category_sql).to_dataframe()\ndisplay(\n    category_results.head(10).style.format({\n        \"fulfilled_item_value\": \"${:,.2f}\",\n        \"avg_item_sale_price\": \"${:,.2f}\",\n        \"value_share_pct\": \"{:.2f}%\"\n    })\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-09T15:25:13.173175Z","iopub.execute_input":"2026-11-09T15:25:13.173502Z","iopub.status.idle":"2026-11-09T15:25:14.387721Z","shell.execute_reply.started":"2026-11-09T15:25:13.173469Z","shell.execute_reply":"2026-11-09T15:25:14.386974Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/google/cloud/bigquery/table.py:2086: UserWarning: BigQuery Storage module not found, fetch data with the REST endpoint instead.\n  warnings.warn(\n","output_type":"stream"},{"output_type":"display_data","data":{"te